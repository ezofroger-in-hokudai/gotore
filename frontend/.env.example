# ローカル開発用。通常はリポジトリルートで make db-start → make env-local。
# 手動設定する場合は frontend/.env.local にコピーし、キーを同じローカルSupabaseの値へ置換する。
# Next.jsを再起動して反映。本番ビルドではNEXT_PUBLIC_値の変更後に再ビルドが必要。
# Next.jsサーバーからFastAPIへの転送先。ブラウザ公開用ではない。Vercelでは不要。
BACKEND_INTERNAL_URL=http://localhost:8000
# この2項目はブラウザに公開される。DBパスワード・Secret/service_roleは入れない。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:59321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
