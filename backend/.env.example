# ローカル開発用。通常はリポジトリルートで make db-start → make env-local。
# 手動設定する場合は backend/.env にコピーし、キーを同じローカルSupabaseの値へ置換する。
# make backend は backend/ を作業ディレクトリとして .env を読む。
APP_NAME=GO TORE API
APP_VERSION=0.1.0
APP_ENV=development
# APP_HOST/APP_PORTは設定値。起動ポートはMakefileのuvicorn --host/--portが決める。
APP_HOST=0.0.0.0
APP_PORT=8000
# API専用。実際のクラウド接続文字列やパスワードをGit・NEXT_PUBLIC_変数へ入れない。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:59322/postgres
# プロセスごとの同時接続上限。0で接続再利用を無効化する。
DATABASE_POOL_MAX_SIZE=4
# フロントエンドと同じプロジェクトのURL・公開キー（Secret/service_roleは使用しない）。
SUPABASE_URL=http://127.0.0.1:59321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# TEST_DATABASE_URLはここへ書かず、テスト実行時の環境変数で渡す。READMEの検証手順を参照。
# SCOREの目標評価・一言コメント。キーはbackendだけに設定する。
OPENAI_API_KEY=
SCORE_MODEL=gpt-5-nano
# 1人あたりJST日単位の呼び出し上限。失敗・訂正の再試行も含む。
SCORE_DAILY_LIMIT=30
GOAL_PROPOSAL_DAILY_LIMIT=10
