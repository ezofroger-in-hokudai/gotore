# Vercelの1プロジェクトへ設定する値の一覧。実際の秘密値はコミットしない。
# このファイルは自動で読み込まれない。Vercelの対象環境へ登録し、変更後は再デプロイする。
# ローカル開発にはbackend/.envとfrontend/.env.localを使う。詳しくはREADME・docs/vercel-supabase.md。
# ブラウザ公開用（Config）。2つのURL・2つのキーはそれぞれ同じSupabaseプロジェクトにそろえる。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# APIの本人確認用（Config）。Secret/service_roleキーは使わない。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# APIだけで扱う秘密値（Secret）。接続先はConnect画面のTransaction Poolerから取得する。
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
APP_ENV=production
# SCOREのAI評価。API専用の秘密キー。未設定でも記録・数値の内訳は保存できる。
OPENAI_API_KEY=
SCORE_MODEL=gpt-5.6-luna
SCORE_DAILY_LIMIT=30
GOAL_PROPOSAL_DAILY_LIMIT=10
